				"code" : "visualizer allFilesIn: 'src/' ofType: 'ts' that:\r\t[:coll | coll select: [:each | \n\t#('main2' 'view-state' 'CardCreator' 'InputCoordinator') detect: [:fileName | \n\t\t(RxMatcher forString: fileName ) search: each basename] \n\t\tifFound: [true] \n\t\tifNone:[false]]]"
